# Use ONLY sandbox tenant; never commit secrets.
SIGNICAT_ISSUER_URL=https://YOUR-SANDBOX-DOMAIN.sandbox.signicat.com/auth/open/
SIGNICAT_CLIENT_ID=REPLACE_WITH_SANDBOX_CLIENT_ID
SIGNICAT_CLIENT_SECRET=REPLACE_WITH_SECRET_IN_PRIVATE_ENV
PUBLIC_ORIGIN=https://YOUR-HTTPS-BACKEND-DOMAIN
PORT=3000

# Idura / formerly Criipto — obtain values from Idura sandbox dashboard
IDURA_ISSUER_URL=https://YOUR-VERIFIED-IDURA-OIDC-ISSUER
IDURA_CLIENT_ID=REPLACE_WITH_IDURA_SANDBOX_CLIENT_ID
IDURA_CLIENT_SECRET=REPLACE_WITH_PRIVATE_IDURA_SANDBOX_SECRET
